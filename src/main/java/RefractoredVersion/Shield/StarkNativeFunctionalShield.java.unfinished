package RefractoredVersion.Shield;

import RefractoredVersion.Engine.*;
import it.unicam.quasylab.jspear.ControlledSystem;
import it.unicam.quasylab.jspear.DefaultRandomGenerator;
import it.unicam.quasylab.jspear.EvolutionSequence;
import it.unicam.quasylab.jspear.controller.Controller;
import it.unicam.quasylab.jspear.controller.ControllerRegistry;
import it.unicam.quasylab.jspear.ds.DataState;
import it.unicam.quasylab.jspear.ds.DataStateUpdate;
import org.apache.commons.math3.random.RandomGenerator;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Objects;

import static RefractoredVersion.Engine.JavaHighwayEngineUtils.*;

public class StarkNativeFunctionalShield {
    private static final double DISTANCE_WANTED = 10;
    private int frequency = 20;
    private int numLanes = 3;
    private int predictionVehicleCount = -1;
    protected static final int EVOLUTION_SEQUENCE_SIZE = 30;
    private static final String CONTROLLER_NAME = "stark-native-highway-controller";
    private List<Action> futureAction = List.of(Action.SLOWER, Action.SLOWER);
    private static final double TARGET_SPEED_SAMPLE_DELTA = 1.0;
    private static final double ACTION_SPEED_DELTA = 5.0;

    public StarkNativeFunctionalShield(List<Action> futureAction ) {
        this.futureAction = futureAction;
    }
    public boolean verifySafe(Action candidateAction) throws Exception {
        Objects.requireNonNull(candidateAction, "candidateAction must not be null");
        return verifySafeSequence(toActionSequence(candidateAction, futureAction));
    }
    private List<Action> toActionSequence(Action candidateAction, List<Action> futureActions) {
        if (candidateAction == null) {
            throw new IllegalArgumentException("candidateAction must not be null");
        }

        List<Action> actionSequence = new ArrayList<>();
        actionSequence.add(candidateAction);
        if (futureActions != null) {
            actionSequence.addAll(futureActions);
        }
        return actionSequence;
    }
    public boolean verifySafeSequence(List<Action> actionSequence){


    }
    private EvolutionSequence getNativePredictionSequence(List<Action> actionSequence) {
        DefaultRandomGenerator random = new DefaultRandomGenerator();
        return new EvolutionSequence(
                random,
                rg -> {
                    Controller controller = getController(actionSequence);
                    DataState state = getInitialState(rg, actionSequence.get(0));
                    return new ControlledSystem(
                            controller,
                            (environmentRg, ds) -> ds.apply(getEnvironmentUpdates(environmentRg, ds)),
                            state
                    );
                },
                EVOLUTION_SEQUENCE_SIZE
        );
    }
    private Controller getController(List<Action> actionSequence) {
        ControllerRegistry registry = new ControllerRegistry();
        registry.set(CONTROLLER_NAME,
                Controller.doAction((rg, ds) -> getControllerUpdates(rg, ds, actionSequence),
                        registry.reference(CONTROLLER_NAME)));
        return registry.reference(CONTROLLER_NAME);
    }
    private double clipTargetSpeed(double targetSpeed) {
        int maxTargetSpeed = 40;
        return Math.max(0.0, Math.min(maxTargetSpeed, targetSpeed));
    }
    private List<DataStateUpdate> getControllerUpdates(RandomGenerator rg, DataState state,
                                                       List<Action> actionSequence) {
        // 1. read ego fields from state
        // 2. apply high-level action to targetSpeed / targetLane
        // 3. compute MOBIL target lane directly from state
        // 4. compute IDM acceleration directly from state
        // 5. return DataStateUpdate list
        List<DataStateUpdate> updates = new ArrayList<>();
        int egoIndex = getEgoVehicleIndex(state);
        if (egoIndex < 0) {
            throw new IllegalStateException("No ego vehicle in DataState");
        }
        if (state.getStep() % frequency == 0) {
            int actionIndex = state.getStep() / frequency;
            if (actionIndex >= actionSequence.size()) {
                throw new IllegalStateException(
                        "Missing action at decision index " + actionIndex
                );
            }
            updates.addAll(applyActionToEgo(
                    state,
                    egoIndex,
                    actionSequence.get(actionIndex)
            ));
        }

    }
    private double value(DataState state, int vehicleIndex, VarTable variable) {
        return state.get(vehicleOffset(vehicleIndex) + variable.ordinal());
    }

    private int intValue(DataState state, int vehicleIndex, VarTable variable) {
        return (int) value(state, vehicleIndex, variable);
    }
    protected int vehicleOffset(int vehicleIndex) {
        return vehicleIndex * VarTable.values().length;
    }
    private int getEgoVehicleIndex(DataState state) {
        for (int i = 0; i < vehicleCount(); i++) {
            if (value(state, i, VarTable.role) == 0.0) {
                return i;
            }
        }
        return -1;
    }
    protected int vehicleCount() {
        if (predictionVehicleCount <= 0) {
            throw new IllegalStateException("Prediction vehicle count is not initialized");
        }
        return predictionVehicleCount;
    }
    private List<DataStateUpdate> applyActionToEgo(
            DataState state,
            int egoIndex,
            Action action
    ) {
        List<DataStateUpdate> updates = new ArrayList<>();
        int egoOffset = vehicleOffset(egoIndex);

        int lane = intValue(state, egoIndex, VarTable.lane_index);
        double targetSpeed = value(state, egoIndex, VarTable.targetSpeed);

        switch (action) {
            case LANE_LEFT:
                updates.add(new DataStateUpdate(
                        egoOffset + VarTable.target_lane_index.ordinal(),
                        Math.max(0, lane - 1)
                ));
                break;

            case LANE_RIGHT:
                updates.add(new DataStateUpdate(
                        egoOffset + VarTable.target_lane_index.ordinal(),
                        Math.min(numLanes - 1, lane + 1)
                ));
                break;

            case FASTER:
                updates.add(new DataStateUpdate(
                        egoOffset + VarTable.targetSpeed.ordinal(),
                        clipTargetSpeed(targetSpeed + 5.0)
                ));
                break;

            case SLOWER:
                updates.add(new DataStateUpdate(
                        egoOffset + VarTable.targetSpeed.ordinal(),
                        clipTargetSpeed(targetSpeed - 5.0)
                ));
                break;

            case IDLE:
                break;

            default:
                throw new IllegalArgumentException("Unsupported action: " + action);
        }

        return updates;
    }
    private boolean isNpc(DataState state, int vehicleIndex) {
        return value(state, vehicleIndex, VarTable.role) != 0.0;
    }

    private boolean isOnLaneWithMargin(DataState state, int vehicleIndex, int laneIndex) {
        double y = value(state, vehicleIndex, VarTable.y);
        double laneCenterY = laneIndex * 4.0;
        double lateral = y - laneCenterY;
        double halfLaneWidth = 2.0;
        double margin = 1.0;
        return Math.abs(lateral) <= halfLaneWidth + margin;
    }
    private int frontVehicleIndexInLane(DataState state, int vehicleIndex, int laneIndex) {
        double x = value(state, vehicleIndex, VarTable.x);
        int frontIndex = -1;
        double closestFrontX = Double.POSITIVE_INFINITY;

        for (int i = 0; i < vehicleCount(); i++) {
            if (i == vehicleIndex) {
                continue;
            }

            if (!isOnLaneWithMargin(state, i, laneIndex)) {
                continue;
            }

            double otherX = value(state, i, VarTable.x);
            if (otherX > x && otherX < closestFrontX) {
                closestFrontX = otherX;
                frontIndex = i;
            }
        }

        return frontIndex;
    }
    private int rearVehicleIndexInLane(DataState state, int vehicleIndex, int laneIndex) {
        double x = value(state, vehicleIndex, VarTable.x);
        int rearIndex = -1;
        double closestRearX = Double.NEGATIVE_INFINITY;

        for (int i = 0; i < vehicleCount(); i++) {
            if (i == vehicleIndex) {
                continue;
            }

            if (!isOnLaneWithMargin(state, i, laneIndex)) {
                continue;
            }

            double otherX = value(state, i, VarTable.x);
            if (otherX < x && otherX > closestRearX) {
                closestRearX = otherX;
                rearIndex = i;
            }
        }

        return rearIndex;
    }
    private  List<Integer> possibleLanes(DataState state, int vehicleIndex) {
        int currentLane = intValue(state, vehicleIndex, VarTable.lane_index);
        List<Integer> lanes = new ArrayList<>();

        for (int lane = currentLane - 1; lane <= currentLane + 1; lane++) {
            if (lane >= 0 && lane < numLanes) {
                lanes.add(lane);
            }
        }

        return lanes;
    }


    private int computeMobilTargetLane(DataState state, int vehicleIndex) throws Exception {
        int laneIndex = intValue(state, vehicleIndex, VarTable.lane_index);
        int targetLaneIndex = intValue(state, vehicleIndex, VarTable.target_lane_index);
        double cooldownTimer = value(state, vehicleIndex, VarTable.cooldownTimer);

        if (cooldownTimer < 1.0 || laneIndex != targetLaneIndex) {
            for (int other = 0; other < vehicleCount(); other++) {
                if (other == vehicleIndex) {
                    continue;
                }

                int otherLaneIndex = intValue(state, other, VarTable.lane_index);
                int otherTargetLaneIndex = intValue(state, other, VarTable.target_lane_index);

                boolean otherIsChangingLane = otherLaneIndex != otherTargetLaneIndex;
                if (otherIsChangingLane && otherTargetLaneIndex == targetLaneIndex) {
                    double d = laneDistanceTo(state, vehicleIndex, other);
                    double dStar = desiredGap(state, vehicleIndex, other);

                    if (0 < d && d < dStar) {
                        return laneIndex;
                    }
                }
            }

            return targetLaneIndex;
        }

        List<Integer> newLane = new ArrayList<>();

        for (int lane : possibleLanes(state, vehicleIndex)) {
            if (lane != laneIndex) {
                double currentA = computeRawAccel(state, vehicleIndex, laneIndex);
                double newA = computeRawAccel(state, vehicleIndex, lane);

                double benefitAOld = 0.0;
                double benefitANew = 0.0;


                int benefitCarBehind = rearVehicleIndexInLane(state, vehicleIndex, laneIndex);
                if (benefitCarBehind >= 0) {
                    benefitAOld = computeRawAccel(state, benefitCarBehind, vehicleIndex);

                    int frontOfLaneChangingVehicle =
                            frontVehicleIndexInLane(state, vehicleIndex, laneIndex);

                    benefitANew = computeRawAccel(
                            state,
                            benefitCarBehind,
                            frontOfLaneChangingVehicle
                    );
                }

                double benefit = benefitANew - benefitAOld;

                double karmaAOld = 0.0;
                double karmaANew = 0.0;

                int karmaCarBehind = rearVehicleIndexInLane(state, vehicleIndex, lane);
                if (karmaCarBehind >= 0) {
                    int frontOfKarmaCar =
                            frontVehicleIndexInLane(state, karmaCarBehind, lane);

                    karmaAOld = computeRawAccel(state, karmaCarBehind, frontOfKarmaCar);
                    karmaANew = computeRawAccel(state, karmaCarBehind, vehicleIndex);
                }

                double karma = karmaANew - karmaAOld;

                double politeness = value(state, vehicleIndex, VarTable.politeness);
                double overallBenefit =
                        (newA - currentA)
                                + politeness * (benefit + karma);

                double LANE_CHANGE_MIN_ACC_GAIN = 0.2;
                if (overallBenefit > LANE_CHANGE_MIN_ACC_GAIN
                        && isSafeConsideringRearVehicle(
                        state,
                        vehicleIndex,
                        karmaCarBehind,
                        karmaANew,
                        newA
                )) {
                    newLane.add(lane);
                }
            }
        }

        if (!newLane.isEmpty()) {
            return newLane.get(newLane.size() - 1);
        }

        return laneIndex;
    }
    private double laneDistanceTo(DataState state, int vehicleIndex, int otherIndex) {
        if (otherIndex < 0) {
            return 0.0;
        }
        return value(state, otherIndex, VarTable.x)
                - value(state, vehicleIndex, VarTable.x);
    }
    private double desiredGap(DataState state, int vehicleIndex, int frontVehicleIndex) {
        if (frontVehicleIndex < 0) {
            return DISTANCE_WANTED;
        }

        double vehicleVx = value(state, vehicleIndex, VarTable.vx);
        double vehicleVy = value(state, vehicleIndex, VarTable.vy);
        double frontVx = value(state, frontVehicleIndex, VarTable.vx);
        double frontVy = value(state, frontVehicleIndex, VarTable.vy);

        double relativeVx = vehicleVx - frontVx;
        double relativeVy = vehicleVy - frontVy;

        double heading = value(state, vehicleIndex, VarTable.heading);
        double dirX = Math.cos(heading);
        double dirY = Math.sin(heading);

        double dv = relativeVx * dirX + relativeVy * dirY;

        double v = value(state, vehicleIndex, VarTable.speed);
        double s0 = DISTANCE_WANTED;
        double vT = v * DEFAULT_TIME_WANTED;

        double kineticTerm =
                (v * dv)
                        / (2.0 * Math.sqrt(COMFORT_ACC_MAX * Math.abs(COMFORT_ACC_MIN)));

        double dStar = s0 + vT + kineticTerm;


        return dStar;
    }

    private double computeRawAccel(DataState state, int vehicleIndex, int laneIndex) throws Exception {
        if (isPControlled(state, vehicleIndex)) {
            return KP_A * (
                    value(state, vehicleIndex, VarTable.targetSpeed)
                            - value(state, vehicleIndex, VarTable.speed)
            );
        }

        double v = value(state, vehicleIndex, VarTable.vx);
        double v0 = notZero(value(state, vehicleIndex, VarTable.targetSpeed));
        double freeFlowTerm = 1.0 - Math.pow(v / v0, DELTA);

        int frontVehicleIndex = frontVehicleIndexInLane(state, vehicleIndex, laneIndex);
        if (frontVehicleIndex < 0) {
            return COMFORT_ACC_MAX * freeFlowTerm;
        }

        double frontVx = value(state, frontVehicleIndex, VarTable.vx);
        double frontX = value(state, frontVehicleIndex, VarTable.x);
        double vehicleX = value(state, vehicleIndex, VarTable.x);

        double dv = v - frontVx;
        double s = frontX - vehicleX - 5;
        s = Math.max(s, 0.01);

        double sStar = DISTANCE_WANTED
                + v * DEFAULT_TIME_WANTED
                + (v * dv) / (2.0 * Math.sqrt(COMFORT_ACC_MAX * Math.abs(COMFORT_ACC_MIN)));
        sStar = Math.max(sStar, DISTANCE_WANTED);

        double interactionTerm = Math.pow(sStar / s, 2.0);
        return COMFORT_ACC_MAX * (freeFlowTerm - interactionTerm);
    }
    private double notZero(double value) {
        double eps = 1e-2;
        if (Math.abs(value) > eps) {
            return value;
        }
        return value >= 0.0 ? eps : -eps;
    }
}
